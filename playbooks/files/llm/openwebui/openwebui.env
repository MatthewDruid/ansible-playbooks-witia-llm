WEBUI_URL=https://ai.example
CORS_ALLOW_ORIGIN=https://ai.example
WEBUI_SESSION_COOKIE_SECURE=true

ENABLE_COMPRESSION_MIDDLEWARE=false

#WEBUI_SECRET_KEY=$(openssl rand -hex 32)
WEBUI_SECRET_KEY=

OFFLINE_MODE=true

DATABASE_URL=postgresql://openwebui:openwebui@postgres:5432/openwebui
DATABASE_POOL_SIZE=15
DATABASE_POOL_MAX_OVERFLOW=20

ENABLE_OPENAI_API=true
OPENAI_API_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=

ENABLE_OLLAMA_API=false

RAG_EMBEDDING_ENGINE=openai
RAG_OPENAI_API_BASE_URL=http://litellm:4000/v1
RAG_OPENAI_API_KEY=
RAG_EMBEDDING_MODEL=poldense-1b

VECTOR_DB=pgvector
PGVECTOR_DB_URL=postgresql://openwebui:openwebui@postgres:5432/openwebui_embedding

REDIS_URL=redis://openwebui:openwebui@openwebui-valkey:6379/0

ENABLE_WEBSOCKET_SUPPORT=true
WEBSOCKET_MANAGER=redis
WEBSOCKET_REDIS_URL=redis://openwebui:openwebui@openwebui-valkey:6379/1

ENABLE_SIGNUP=false

